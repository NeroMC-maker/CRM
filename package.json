{
  "name": "tulicencia-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CRM interno de Tulicencia.com.pe — venta rápida, calendario de clases, flota y análisis",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "importar:excel": "tsx scripts/importar-excel.ts",
    "api": "tsx watch --env-file=.env server/node.ts",
    "web": "vite",
    "dev": "concurrently -k -n db,api,web -c blue,green,cyan \"pnpm db\" \"pnpm api\" \"pnpm web\"",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
